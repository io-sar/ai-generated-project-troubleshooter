{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./.streamlit/secrets.toml)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git push *)",
      "Bash(git push * --delete *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh release *)",
      "Bash(gh secret *)",
      "Bash(gh api *)",
      "Bash(gh workflow run *)",
      "Bash(*record_sample*)",
      "Bash(*record_llm_fixtures*)",
      "Bash(*run_evals*)"
    ],
    "allow": [
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format)",
      "Bash(uv run ruff format *)",
      "Bash(uv run mypy)",
      "Bash(uv run mypy *)",
      "Bash(uv run lint-imports)",
      "Bash(uv run lint-imports *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python -c \"import json, re, sys; c = json.load(sys.stdin).get('tool_input', {}).get('command', ''); hit = re.search(r'\\.env(?!\\w)|secrets\\.toml', c); hit and sys.stderr.write('Blocked: this command mentions .env or secrets.toml, which hold secrets.\\n'); sys.exit(2 if hit else 0)\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python -c \"import json, subprocess, sys; p = json.load(sys.stdin).get('tool_input', {}).get('file_path', ''); sys.exit(subprocess.run(['ruff', 'format', '--quiet', p]).returncode if p.endswith('.py') else 0)\""
          }
        ]
      }
    ]
  }
}
