{#- Autoescaping is on for every value. Never add the |safe filter here. -#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; color: #1f2328; background: #fff; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; }
  h1 { margin-bottom: 0.25rem; }
  h2 { border-bottom: 1px solid #d0d7de; padding-bottom: 0.25rem; margin-top: 2rem; }
  table { border-collapse: collapse; width: 100%; margin: 0.75rem 0; font-size: 0.9rem; }
  th, td { border: 1px solid #d0d7de; padding: 0.4rem 0.5rem; text-align: left; vertical-align: top; }
  th { background: #f6f8fa; }
  .meta { color: #59636e; margin: 0.25rem 0; }
  .badge { display: inline-block; padding: 0.1rem 0.5rem; border-radius: 0.75rem; font-weight: 600; font-size: 0.85rem; border: 1px solid currentColor; }
  .good, .recorded { color: #1a7f37; background: #dafbe1; }
  .problematic, .placeholder { color: #9a6700; background: #fff8c5; }
  .at_risk { color: #cf222e; background: #ffebe9; }
  .live { color: #0969da; background: #ddf4ff; }
  .warning { color: #cf222e; font-weight: 600; }
  .scenario, .update, .note { white-space: pre-wrap; }
  .update { background: #f6f8fa; border-radius: 0.375rem; padding: 0.75rem; }
  @media print {
    body { margin: 0; max-width: none; font-size: 10pt; }
    h2 { break-after: avoid; }
    table, tr, .update { break-inside: avoid; }
    .badge { border-width: 2px; }
  }
</style>
</head>
<body>
<h1>{{ title }}</h1>
<p class="meta">{{ t("export.badge") }}: <span class="badge {{ source }}">{{ t("badge." ~ source) }}</span></p>
<p class="meta">{{ t("export.generated") }}: {{ generated }}</p>

<h2>{{ t("report.scenario") }}</h2>
<p class="scenario">{{ scenario.text }}</p>
{% if scenario.key_points %}
<h3>{{ t("report.key_points") }}</h3>
<ul>
{% for point, where in key_points %}
  <li>{{ point }}{% if where %} <em>({{ t("report.covered_by", where=where) }})</em>{% endif %}</li>
{% endfor %}
</ul>
{% endif %}

<h2>{{ t("health.title") }}</h2>
<p>{{ t("health.overall") }}: <span class="badge {{ overall }}">{{ t("health_label." ~ overall) }}</span></p>
<table>
  <tr><th>{{ t("hood.dimension") }}</th><th>{{ t("health.status") }}</th><th>{{ t("health.rationale") }}</th></tr>
{% for d in dimensions %}
  <tr><td>{{ t("dimension." ~ d.code) }}</td><td><span class="badge {{ d.label }}">{{ t("health_label." ~ d.label) }}</span>{% if d.adjusted %} <span class="badge">{{ t("edit.marker") }}</span>{% endif %}</td><td>{{ d.rationale }}{% if d.note %}<br><em>{{ t("edit.note_shown", note=d.note) }}</em>{% endif %}</td></tr>
{% endfor %}
</table>

<h2>{{ t("risks.title") }}</h2>
<table>
  <tr><th>{{ t("risks.id") }}</th><th>{{ t("risks.description") }}</th><th>{{ t("risks.likelihood") }}</th><th>{{ t("risks.impact") }}</th><th>{{ t("risks.score") }}</th><th>{{ t("risks.owner") }}</th><th>{{ t("risks.mitigation") }}</th><th>{{ t("risks.escalation") }}</th><th>{{ t("risks.signals") }}</th></tr>
{% for item in risks %}
{% set risk = item.risk %}
  <tr><td>{{ risk.id }}{% if risk.human_adjusted %} <span class="badge">{{ t("edit.marker") }}</span>{% endif %}</td><td>{{ risk.description }}</td><td>{{ risk.likelihood }}</td><td>{{ risk.impact }}</td><td>{{ item.score }}</td><td>{{ risk.owner }}</td><td>{{ risk.mitigation }}</td><td>{{ t("escalation." ~ risk.escalation) }}</td><td>{{ risk.signal_ids | join(", ") }}</td></tr>
{% endfor %}
</table>

<h2>{{ t("plan.title") }}</h2>
<p>{{ t("plan.sequencing") }}</p>
{% for name, sprint in sprints %}
<h3>{{ t("plan." ~ name) }}</h3>
<p>{{ sprint.goal }}</p>
<table>
  <tr><th>{{ t("plan.action") }}</th><th>{{ t("plan.owner") }}</th><th>{{ t("plan.success_signal") }}</th></tr>
{% for action in sprint.actions %}
  <tr><td>{{ action.description }}</td><td>{{ action.owner }}</td><td>{{ action.success_signal }}</td></tr>
{% endfor %}
</table>
{% endfor %}

<h2>{{ t("updates.title") }}</h2>
{% for audience, text in updates %}
<h3>{{ t("updates." ~ audience) }}</h3>
<p class="update">{{ text }}</p>
{% endfor %}

<h2>{{ t("memo.title") }}</h2>
<h3>{{ t("memo.context") }}</h3>
<p>{{ memo.context }}</p>
<table>
  <tr><th>{{ t("memo.option") }}</th><th>{{ t("memo.trade_offs") }}</th></tr>
{% for option in memo.options %}
  <tr><td>{{ option.title }}</td><td>{{ option.trade_offs }}</td></tr>
{% endfor %}
</table>
<h3>{{ t("memo.recommendation") }}</h3>
<p>{{ memo.recommendation }}</p>
<h3>{{ t("memo.success_metrics") }}</h3>
<ul>
{% for metric in memo.success_metrics %}
  <li>{{ metric }}</li>
{% endfor %}
</ul>

<h2>{{ t("raci.title") }}</h2>
<table>
  <tr><th>{{ t("raci.activity") }}</th>{% for role in roles %}<th>{{ role }}</th>{% endfor %}<th>{{ t("raci.check") }}</th></tr>
{% for row in raci %}
  <tr><td>{{ row.activity }}{% if row.adjusted %} <span class="badge">{{ t("edit.marker") }}</span>{% endif %}</td>{% for role in roles %}<td>{{ row.cells[role] }}</td>{% endfor %}<td>{% if row.broken %}<span class="warning">{{ t("raci.needs_one_a") }}</span>{% endif %}</td></tr>
{% endfor %}
</table>
{% if changes %}

<h2>{{ t("compare.changes") }}</h2>
<p class="note">{{ changes }}</p>
{% endif %}
</body>
</html>
